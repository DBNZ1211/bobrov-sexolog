# Enable after certificates exist:
#   cp deploy/nginx/conf.d/01-tls.conf.example deploy/nginx/conf.d/01-tls.conf
#   docker compose exec nginx nginx -s reload
#
# Or run: sh deploy/init-ssl.sh

server {
  listen 80;
  listen [::]:80;
  server_name bobrov-sexolog.ru www.bobrov-sexolog.ru;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://bobrov-sexolog.ru$request_uri;
  }
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name www.bobrov-sexolog.ru;

  ssl_certificate     /etc/letsencrypt/live/bobrov-sexolog.ru/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/bobrov-sexolog.ru/privkey.pem;
  ssl_session_timeout 1d;
  ssl_session_cache shared:SSL:10m;
  ssl_protocols TLSv1.2 TLSv1.3;

  return 301 https://bobrov-sexolog.ru$request_uri;
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name bobrov-sexolog.ru;

  ssl_certificate     /etc/letsencrypt/live/bobrov-sexolog.ru/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/bobrov-sexolog.ru/privkey.pem;
  ssl_session_timeout 1d;
  ssl_session_cache shared:SSL:10m;
  ssl_protocols TLSv1.2 TLSv1.3;

  add_header X-Frame-Options SAMEORIGIN always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  location / {
    proxy_pass http://website_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
  }
}
