ADMIN_USER=admin
ADMIN_PASSWORD=change-me-strong-password
SESSION_SECRET=change-me-long-random-string
# Local only. In Docker compose forces NUXT_DATA_DIR=/app/data (do not rely on this).
DATA_DIR=./data
NUXT_PUBLIC_SITE_URL=https://bobrov-sexolog.ru
NUXT_PUBLIC_PHONE=+7 964 594-12-01
NUXT_PUBLIC_PHONE_HREF=tel:+79645941201

# Docker / certbot
DOMAIN=bobrov-sexolog.ru
CERTBOT_EMAIL=admin@bobrov-sexolog.ru

# Optional aliases (Nuxt runtime). docker-compose maps ADMIN_* → NUXT_* automatically.
# NUXT_ADMIN_USER=
# NUXT_ADMIN_PASSWORD=
# NUXT_SESSION_SECRET=

# Stable OG image signing secret for Docker / multi-instance
# NUXT_OG_IMAGE_SECRET=
